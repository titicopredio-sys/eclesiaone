{
  "name": "eclesia-one",
  "version": "3.0.0",
  "description": "Eclesia One - Centro de Comando Digital da Igreja: plataforma integrada de gestao eclesiastica (pessoas, celulas, pastoral, financeiro, operacao, comunicacao e inteligencia).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed-cli.js",
    "test": "node tests/api-test.mjs",
    "setup": "node server/bootstrap.js",
    "test:render": "RENDER_MODE=login node tests/render-test.mjs && RENDER_MODE=app node tests/render-test.mjs",
    "build:static": "node tools/build-static.mjs",
    "snapshot": "node tools/snapshot.mjs",
    "test:demo": "RENDER_MODE=login SNAPSHOT_OUT= node tools/demo-check.mjs",
    "ver": "node -e \"console.log(require('./package.json').version)\"",
    "master": "node server/provision-master.js"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "license": "PROPRIETARY",
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
